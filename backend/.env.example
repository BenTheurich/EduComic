# Backend environment template
# Copy this file to backend/.env for local development.
# Never commit backend/.env or any real secret values.

# OpenAI
# Server-side secret. Do not expose this value to the frontend.
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=<your-openai-model>
OPENAI_QA_MODEL=<your-openai-vision-review-model>

# Black Forest Labs / FLUX
# Server-side secret used by avatar and comic image generation.
BFL_API_KEY=<your-black-forest-labs-api-key>
BFL_MODEL_ENDPOINT=<your-black-forest-labs-model-endpoint>

# Panel review
PANEL_REVIEW_ENABLED=false
PANEL_REVIEW_MIN_SCORE=9.0
PANEL_REVIEW_MAX_ATTEMPTS=3

# Application
ENVIRONMENT=<development-or-production>
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional. Defaults to backend/data and its educomic.db file.
# EDUCOMIC_DATA_DIR=C:/private/educomic-data
# DATABASE_URL=sqlite:///C:/private/educomic-data/educomic.db
