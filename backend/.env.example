# Backend environment template
# Copy this file to backend/.env for local development.
# Never commit backend/.env or any real secret values.

# Supabase
# Use the anon key only when backend requests are protected by RLS.
# Keep service-role keys server-side only and rotate them immediately if exposed.
SUPABASE_URL=<your-supabase-project-url>
SUPABASE_KEY=<your-supabase-anon-or-server-side-key>
SUPABASE_IMAGES_BUCKET=<your-generated-images-bucket-name>

# OpenAI
# Server-side secret. Do not expose this value to the frontend.
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=<your-openai-model>
OPENAI_QA_MODEL=<your-openai-vision-review-model>

# Black Forest Labs / FLUX
# Server-side secret. BFL_API_KEY is preferred by image generation code;
# BLACK_FOREST_API_KEY is still supported by older code paths.
BFL_API_KEY=<your-black-forest-labs-api-key>
BLACK_FOREST_API_KEY=<your-black-forest-labs-api-key>
BFL_API_BASE=<your-black-forest-labs-api-base-url>
BFL_MODEL_ENDPOINT=<your-black-forest-labs-model-endpoint>

# Panel review
PANEL_REVIEW_ENABLED=<true-or-false>
PANEL_REVIEW_MIN_SCORE=<minimum-review-score>
PANEL_REVIEW_MAX_ATTEMPTS=<maximum-review-attempts>

# Application
ENVIRONMENT=<development-or-production>
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
